# ── 网状拓扑（P7）：任意节点都能给任意节点派活 ──
# 大脑漂到哪台机器，就由哪台去派活。Windows 独有能力(browser/screen/outlook/
# maintenance)在 Mac 当大脑时必须能派回 Windows，因此需要反向 SSH 目标。
# 注意方向：MAC_SATELLITE_* 是 Windows→Mac，下面这两个是 Mac→Windows，密钥不通用。
WINDOWS_SSH_HOST=user@100.68.6.52
WINDOWS_SSH_KEY=~/.ssh/pai_windows

# 对端 Tailscale IP —— supervisor 判断对端是否存活的唯一输入。
# 曾经只存在于代码里、从未进过配置文件，换机重装必踩坑，故在此登记。
# 在 Windows 上填 Mac 的地址，在 Mac 上填 Windows 的地址。
PEER_TAILSCALE_IP=100.66.80.98

# ── 推送节奏（2026-08-03 修）──
# 学校/个人邮件跟随 SCHOOL_CHECK_TIMES 的时间槽，同一槽合并成一条摘要。
# 游戏资讯完全不紧急，单独只在晚间推一次，避免和邮件抢注意力。
# 背景：此前游戏 catchup 无条件开 120 分钟窗口且从不关闭，
# 导致同一批内容每 5 分钟重推一次，单日曾达 57 条。
GAME_NEWS_SLOTS=20:00
