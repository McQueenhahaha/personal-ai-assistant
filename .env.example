# Canvas API/ICS settings for your school. Keep real tokens and feed URLs in .env only.
CANVAS_BASE_URL=https://<your-school>.instructure.com
CANVAS_API_TOKEN=<your-canvas-api-token>
CANVAS_ICS_URL=https://<your-school>.instructure.com/feeds/calendars/<your-calendar-feed>.ics
CANVAS_TOKEN_EXPIRES_AT=YYYY-MM-DD

# SSH target and private-key path for the optional macOS satellite.
MAC_SATELLITE_HOST=user@100.x.y.z
MAC_SATELLITE_KEY=<path-to-private-key>

# Optional description used to tailor generated study documents.
STUDY_LEARNER_PROFILE=<your-learner-profile>

